# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# Comma-separated list. No wildcard in production.
CORS_ORIGINS=https://bellaqueenfestival.tn,https://www.bellaqueenfestival.tn
# Set to 1 when behind nginx, so rate limiting sees the real client IP
TRUST_PROXY=1

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/bellaqueen

# ── Edition rules ────────────────────────────────────────────────────────────
EDITION_ID=2026
MAX_SCHOOLS=150
MAX_SEATS_PER_DAY=2000
SEATS_PER_BOOKLET=50
# Hours a pending registration holds its slot before the job releases it
PENDING_TTL_HOURS=72
# Registration opens at this instant. Before it, POST /api/registrations is 409.
# Leave blank to open immediately.
REGISTRATION_OPENS_AT=

# ── Admin auth ───────────────────────────────────────────────────────────────
# openssl rand -hex 48
JWT_SECRET=change-me-openssl-rand-hex-48
JWT_TTL=8h

# ── Mail (fill the day contact@bellaqueenfestival.tn exists) ─────────────────
# Until SMTP_USER is set, confirmations are logged to stdout instead of sent.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=contact@bellaqueenfestival.tn
MAIL_FROM_NAME=FIESTADREAM 2026
MAIL_REPLY_TO=contact@bellaqueenfestival.tn
FESTIVAL_PHONE=+216 00 000 000

# Who is alerted when a school registers. Comma-separated, no spaces needed.
# These e-mails contain the director's name, phone and address, so list only
# real organiser accounts. Leave blank to disable the alerts completely.
ORGANISER_EMAILS=
# Also alert on waiting-list joins (true/false). Registrations always alert.
ALERT_ON_WAITLIST=true

# Amounts shown on the receipt (carnet = 50 Pass at 20 DT = 1000 DT total)
DEPOSIT_DT=500
BALANCE_DT=500

# Absolute path to the signed Charte d'honneur PDF. Attached to the approval
# e-mail when it exists; skipped with a warning when it does not.
CHARTER_PDF_PATH=